rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo se guardan datos temporales de señalización (para que los dispositivos se encuentren).
    // Los mensajes, audios, llamadas y archivos NO pasan por Firebase.
    // "list" no está permitido: nadie puede ver qué salas existen, solo entrar a la que conoce.

    // Salas rápidas (código de 6 letras)
    match /rooms/{roomId} {
      allow get, create, update, delete: if request.auth != null;

      match /{sub}/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // Salas privadas: el ID sale de nombre + contraseña (PBKDF2, 40 caracteres).
    // Mensajes, nombres y archivos se guardan cifrados: Firebase no puede leerlos.
    match /chats/{chatId} {
      allow get, create, update: if request.auth != null && chatId.size() == 40;

      match /{sub}/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // Punto de encuentro para las conexiones directas de las llamadas
    match /lines/{lineId} {
      allow get, create, update, delete: if request.auth != null && lineId.size() == 40;

      match /ice/{docId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
